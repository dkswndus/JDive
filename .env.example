# 이 파일을 .env 로 복사해서 쓴다. .env 는 절대 커밋하지 않는다(저장소가 공개다).
# 값이 비어 있는 항목은 직접 채워야 한다. 시크릿은 이 파일에 적지 않는다.

# 브라우저가 접속하는 공개 URL. Google Redirect URI 는 {PUBLIC_BASE_URL}/api/v1/auth/google/callback 이다.
PUBLIC_BASE_URL=http://localhost:3000

# 로컬 개발 DB (docker compose up -d db). 호스트 포트는 5433 이다.
POSTGRES_PASSWORD=jdive_dev
DB_PORT=5433
DATABASE_URL=postgresql+psycopg://jdive:jdive_dev@127.0.0.1:5433/jdive

# OAuth 진행 중 임시 쿠키(state·nonce·PKCE verifier)를 서명하는 키. 32자 이상 무작위 문자열로 바꾼다.
SESSION_SECRET=

# Google Cloud Console 에서 만든 OAuth 클라이언트. 직접 채운다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 오류 수집(Sentry). 비워 두면 비활성이다.
SENTRY_DSN=
# 프론트엔드 오류 수집 DSN. docker compose 로 프론트엔드를 빌드할 때만 쓴다(로컬 개발은 frontend/.env.local).
NEXT_PUBLIC_SENTRY_DSN=
